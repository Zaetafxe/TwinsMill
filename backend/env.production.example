APP_NAME=Smart Milling AI Platform API
ENV=prod
MONGODB_DB=smart_milling
API_PREFIX=/api/v1
AUTH_SECRET_KEY=change-me-long-random-secret
AUTH_ISSUER=twinsmill-api
AUTH_AUDIENCE=twinsmill-web
PLATFORM_ADMIN_EMAIL=admin@your-domain.com
FRONTEND_ORIGINS=https://your-domain.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
ENABLE_SYNTHETIC_SEED=false
